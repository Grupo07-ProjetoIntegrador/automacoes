# ==============================================================================
# CONFIGURAÇÃO DO SERVIÇO DE AUTOMAÇÕES (PYTHON / FASTAPI) - SHOPPING FLAMBOYANT
# ==============================================================================
# Copie este arquivo para .env nesta mesma pasta:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS POSTGRESQL (SUPABASE)
# ------------------------------------------------------------------------------
# String de conexão direta (porta 5432) do Supabase
DATABASE_URL=postgresql://postgres:sua_senha@db.sua_referencia.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. INTEGRAÇÃO COM O BACKEND CORE (GO)
# ------------------------------------------------------------------------------
# URL do backend em Go (para repassar webhooks de inscrição e confirmação de presença)
# Local: http://localhost:8080
# Docker interno: http://core-backend:8080
# Produção: https://jpmallflamboyant.live
BACKEND_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. URL PÚBLICA DE RECEBIMENTO DE WEBHOOKS (NGROK OU DOMÍNIO PÚBLICO)
# ------------------------------------------------------------------------------
# O Google Apps Script / Forms roda nos servidores em nuvem do Google e precisa alcançar
# seu endpoint /api/automacoes/webhook-inscricao.
# Em desenvolvimento local: use ngrok (ex: https://abc1234.ngrok-free.app) ou Cloudflare Tunnel.
# Em produção: use o domínio público oficial (ex: https://jpmallflamboyant.live).
AUTOMACOES_PUBLIC_URL=https://seu-subdominio.ngrok-free.dev

# ------------------------------------------------------------------------------
# 4. GOOGLE APPS SCRIPT WEB APP (VINCULAÇÃO AUTOMÁTICA DE GATILHOS)
# ------------------------------------------------------------------------------
# URL de implantação do seu Web App no Google Apps Script (terminada em /exec)
APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec

# Token secreto compartilhado entre este serviço e o Apps Script para validar requisições
APPS_SCRIPT_TOKEN=seu_token_compartilhado_aqui

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD CREDENTIALS & IDENTIFICADOR DE CONTA MASTER
# ------------------------------------------------------------------------------
# Identificador do usuário master no banco (usado para recuperar tokens OAuth do Gmail/Drive)
GOOGLE_MASTER_USER_ID=master_user_default

# Arquivo JSON de Service Account do Google Cloud (colocado na raiz da pasta /automacoes)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Credenciais do OAuth 2.0 Client ID (tipo "Desktop App") do Google Cloud
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret

# ------------------------------------------------------------------------------
# 6. CONFIGURAÇÃO DE E-MAIL SMTP (FALLBACK CASO NÃO UTILIZE GMAIL API)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_aplicativo_do_gmail
DEFAULT_DESTINATION_EMAIL=email_destino_testes@exemplo.com

# ------------------------------------------------------------------------------
# 7. NOTIFICAÇÕES WHATSAPP (CRON DE LEMBRETES D-1 E D-0)
# ------------------------------------------------------------------------------
# Modo: 'mock' (apenas grava logs em /logs/whatsapp_envios.log) ou 'production' (API real)
WHATSAPP_API_MODE=mock
WHATSAPP_API_URL=https://api.evolution.sua-instancia.com/message/sendText
WHATSAPP_API_TOKEN=seu_token_aqui
