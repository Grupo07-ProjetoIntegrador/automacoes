# URL do banco PostgreSQL do Supabase (ex: postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres)

DATABASE_URL=postgresql://postgres:sua_senha@db.sua_referencia.supabase.co:5432/postgres



# URL do backend em Go (para o Python fazer chamadas, ex: repasse de webhook e patches)

BACKEND_URL=http://localhost:8080



# URL publica do servico de automacoes (ex: ngrok)

AUTOMACOES_PUBLIC_URL=https://seu-subdominio.ngrok-free.dev



# URL do Web App do Apps Script para registrar gatilhos automaticos

APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec
APPS_SCRIPT_TOKEN=seu_token_compartilhado



# Credenciais OAuth do Google usadas no fluxo de autorizacao do usuario

GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret


# Credenciais do Google Cloud Service Account

# O arquivo credentials.json deve ser colocado na raiz da pasta /automacoes

GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json



# Configurações de SMTP para Envio do Link do Formulário por e-mail

SMTP_SERVER=smtp.gmail.com

SMTP_PORT=587

SMTP_EMAIL=seu_email@gmail.com

SMTP_PASSWORD=sua_senha_de_aplicativo_do_gmail

DEFAULT_DESTINATION_EMAIL=email_do_admin_ou_destino@exemplo.com



# Configurações de Envio de WhatsApp (mock ou production)

WHATSAPP_API_MODE=mock

WHATSAPP_API_URL=https://api.evolution.xxx/message/sendText

WHATSAPP_API_TOKEN=seu_token_aqui 

